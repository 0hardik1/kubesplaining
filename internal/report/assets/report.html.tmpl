    .chain { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; min-width: 0; flex: 1; font-size: 13.5px; }
    .chain-node { font-family: var(--mono); font-size: 12.5px; color: var(--text); background: var(--surface-3); border-radius: 5px; padding: 1px 7px; overflow-wrap: anywhere; }
