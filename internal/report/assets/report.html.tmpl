    /* Hop-by-hop chain (rendered by escalationPathHTML, shared with Findings). */
    ol.attack-chain { list-style: none; padding: 0; margin: 12px 0 0; counter-reset: hop; }
    .attack-step { position: relative; padding: 0 0 14px 30px; margin: 0; }
    .attack-step::before { counter-increment: hop; content: counter(hop); position: absolute; left: 0; top: 1px; width: 20px; height: 20px; border-radius: 50%; background: var(--surface-3); color: var(--text-2); font-size: 11px; font-weight: 700; display: grid; place-items: center; }
    .attack-step::after { content: ""; position: absolute; left: 9.5px; top: 24px; bottom: 2px; width: 1px; background: var(--line); }
    .attack-step:last-child { padding-bottom: 0; }
    .attack-step:last-child::after { display: none; }
    .step-hd { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; }
