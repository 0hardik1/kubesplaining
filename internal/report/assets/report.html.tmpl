    .cf-findings { list-style: none; margin: 0; padding: 4px 16px 12px 46px; }
    .cf-findings li { display: flex; align-items: baseline; gap: 10px; padding: 4px 0; font-size: 13.5px; color: var(--text-2); }
    .cf-findings .rule-chip { flex: none; }
    .cf-findings li > span:last-child { min-width: 0; overflow-wrap: anywhere; }

    .footer { margin-top: 48px; color: var(--text-3); font-size: 12.5px; text-align: center; }

    /* Hover definition for glossary terms. */
    .tip { position: absolute; z-index: 40; max-width: 340px; background: #070a11; border: 1px solid var(--line-strong); border-radius: 8px; padding: 8px 12px; font-size: 13px; color: var(--text-2); pointer-events: none; transform: translate(-50%, calc(-100% - 8px)); box-shadow: 0 8px 24px rgba(0,0,0,0.4); }
    .tip strong { display: block; color: var(--text); margin-bottom: 2px; }

    @media (max-width: 900px) {
      :root { --topbar-h: 96px; }
      .hero { grid-template-columns: 1fr; }
      .score { text-align: left; }
      .sev-strip { grid-template-columns: repeat(2, 1fr); }
      .two-col, .recon-body { grid-template-columns: minmax(0, 1fr); }
      .findings-layout { grid-template-columns: minmax(0, 1fr); }
      .f-side { position: static; max-height: none; }
      .targets td.t-path { display: none; }
    }
    @media (max-width: 600px) {
      .wrap { padding: 0 16px; }
      .meta { display: none; }
      .bar-row { grid-template-columns: 110px 1fr 36px; }
      .recon-row, .ev-row { grid-template-columns: 1fr; gap: 2px; }
      .instance-body { padding-left: 4px; }
      .path-row > summary { flex-wrap: wrap; }
      .chain-edge, .path-meta { white-space: normal; }
    }
    @media print {
      .topbar { position: static; }
      .tabs, .f-side, .target-picker { display: none !important; }
      .js .panel, .js .target-view { display: block !important; }
    }
  </style>
  <script>document.documentElement.classList.add('js');</script>
</head>
<body data-active-tab="{{ if .DefaultTab }}{{ .DefaultTab }}{{ else }}summary{{ end }}">
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
      <pattern id="ap-dots" width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="1.5" cy="1.5" r="1" fill="rgba(255,255,255,0.09)"/></pattern>
      <linearGradient id="ap-sheen" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff" stop-opacity="0.07"/><stop offset="0.55" stop-color="#ffffff" stop-opacity="0"/></linearGradient>
      <filter id="ap-blur" x="-40%" y="-60%" width="180%" height="220%"><feGaussianBlur stdDeviation="12"/></filter>
      <symbol id="i-sa" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5.5" width="11" height="8" rx="2.5"/><path d="M8 3v2.5"/><circle cx="8" cy="2.2" r="0.9"/><circle cx="6" cy="9.5" r="0.9" fill="currentColor" stroke="none"/><circle cx="10" cy="9.5" r="0.9" fill="currentColor" stroke="none"/></symbol>
      <symbol id="i-user" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="5.2" r="2.9"/><path d="M2.8 14c0-2.9 2.3-4.7 5.2-4.7s5.2 1.8 5.2 4.7"/></symbol>
      <symbol id="i-group" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="5.5" r="2.5"/><path d="M1.8 13.5c0-2.5 1.9-4 4.2-4s4.2 1.5 4.2 4"/><path d="M10.5 3.3a2.5 2.5 0 0 1 0 4.6"/><path d="M12 9.8c1.4.5 2.3 1.7 2.3 3.7"/></symbol>
      <symbol id="i-cloud" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13h7a3 3 0 0 0 .5-5.95A4.5 4.5 0 0 0 3.9 8.2 2.4 2.4 0 0 0 5 13z"/></symbol>
      <symbol id="i-ns" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 1.8l6 3.3v5.8l-6 3.3-6-3.3V5.1z"/><path d="M2 5.1l6 3.3 6-3.3M8 8.4v5.8"/></symbol>
      <symbol id="i-crown" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 12.5h11M2.5 12.5L1.8 5l3.7 2.8L8 3.2l2.5 4.6L14.2 5l-.7 7.5z"/></symbol>
      <symbol id="i-server" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2.5" width="12" height="4.6" rx="1.3"/><rect x="2" y="8.9" width="12" height="4.6" rx="1.3"/><path d="M4.6 4.8h.01M4.6 11.2h.01" stroke-width="2"/></symbol>
      <symbol id="i-key" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="5.5" cy="10.5" r="3"/><path d="M7.7 8.3L14 2M11.2 4.8l2 2M9.4 6.6l2 2"/></symbol>
      <symbol id="i-net" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="3.5" r="2"/><circle cx="3" cy="12.5" r="2"/><circle cx="13" cy="12.5" r="2"/><path d="M8 5.5v2.6M8 8.1l-3.8 2.8M8 8.1l3.8 2.8"/></symbol>
      <symbol id="i-target" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="5.5"/><circle cx="8" cy="8" r="2"/><path d="M8 1v2.5M8 12.5V15M1 8h2.5M12.5 8H15"/></symbol>
      <symbol id="i-chev" viewBox="0 0 16 16"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    </defs>
  </svg>

  <header class="topbar">
    <div class="wrap topbar-row">
      <div class="brand"><span class="brand-mark">K</span>Kubesplaining <span class="brand-sub">security report</span></div>
      <div class="meta">
        {{ if .Snapshot.Metadata.ClusterName }}<span>Cluster <strong>{{ .Snapshot.Metadata.ClusterName }}</strong></span>{{ end }}
        {{ if .Snapshot.Metadata.ClusterVersion }}<span>Kubernetes <strong>{{ .Snapshot.Metadata.ClusterVersion }}</strong></span>{{ end }}
        {{ if .Snapshot.Metadata.SnapshotTimestamp }}<span>Snapshot <strong>{{ .Snapshot.Metadata.SnapshotTimestamp }}</strong></span>{{ end }}
      </div>
    </div>
    <nav class="wrap tabs" role="tablist" aria-label="Report sections">
      {{ if not .LeastPrivilegeOnly }}
      <button type="button" class="tab" role="tab" id="tabbtn-summary" aria-controls="tab-summary" aria-selected="false" data-tab="summary">Summary</button>
      {{ if gt (len .PrivescPaths.Groups) 0 }}
      <button type="button" class="tab" role="tab" id="tabbtn-paths" aria-controls="tab-paths" aria-selected="false" data-tab="paths">Attack paths <span class="n">{{ .PrivescPaths.Total }}</span></button>
      {{ end }}
      <button type="button" class="tab" role="tab" id="tabbtn-findings" aria-controls="tab-findings" aria-selected="false" data-tab="findings">Findings <span class="n">{{ .Summary.Total }}</span></button>
      {{ end }}
      <button type="button" class="tab" role="tab" id="tabbtn-leastprivilege" aria-controls="tab-leastprivilege" aria-selected="false" data-tab="leastprivilege">Least privilege <span class="n">{{ .LeastPrivilege.Total }}</span></button>
      {{ if and (not .LeastPrivilegeOnly) (gt (len .Compliance.Frameworks) 0) }}
      <button type="button" class="tab" role="tab" id="tabbtn-compliance" aria-controls="tab-compliance" aria-selected="false" data-tab="compliance">Compliance <span class="n">{{ .Compliance.Total }}</span></button>
      {{ end }}
    </nav>
  </header>

  <main class="wrap">
    {{ if not .LeastPrivilegeOnly }}
    <!-- ======================= Summary ======================= -->
    <section class="panel" data-tab="summary" id="tab-summary" role="tabpanel" aria-labelledby="tabbtn-summary">
      <div class="hero">
        <div>
          <h1>{{ .Headline }}</h1>
          {{ if .Summaries }}<p class="lede">{{ .Summaries }}</p>{{ end }}
        </div>
        <div class="score {{ lower .RiskLevel }}" title="Weighted from the finding counts below: critical findings count most.">
          <div class="score-num">{{ .RiskIndex }}<span>/ 100</span></div>
          <div class="score-lbl">{{ .RiskLevel }} risk</div>
        </div>
      </div>

      <div class="sev-strip">
        <button type="button" class="sev-tile crit" data-fl-target="severity:crit"><span class="n">{{ .Summary.Critical }}</span><span class="l">Critical</span></button>
        <button type="button" class="sev-tile high" data-fl-target="severity:high"><span class="n">{{ .Summary.High }}</span><span class="l">High</span></button>
        <button type="button" class="sev-tile med" data-fl-target="severity:med"><span class="n">{{ .Summary.Medium }}</span><span class="l">Medium</span></button>
        <button type="button" class="sev-tile low" data-fl-target="severity:low"><span class="n">{{ .Summary.Low }}</span><span class="l">Low</span></button>
      </div>

      {{ if and .Admission.Mode (or .Admission.Suppressed .Admission.Attenuated) }}
      <div class="banner admission-banner">
        <strong>Pod Security Admission:</strong>
        {{ if .Admission.Suppressed }}{{ .Admission.Suppressed }} pod-security {{ pluralize .Admission.Suppressed "finding" "findings" }} hidden{{ end }}{{ if and .Admission.Suppressed .Admission.Attenuated }}, {{ end }}{{ if .Admission.Attenuated }}{{ .Admission.Attenuated }} {{ pluralize .Admission.Attenuated "finding" "findings" }} lowered in severity{{ end }},
        because the namespace's <code>pod-security.kubernetes.io/enforce</code> label blocks them at admission. Run with <code>--admission-mode=off</code> to see them all.
        {{ if .Admission.SuppressedByNamespace }}
        <details>
          <summary>Hidden findings by namespace</summary>
          <ul class="note-list">
            {{ range $ns, $rules := .Admission.SuppressedByNamespace }}
            <li><strong>{{ $ns }}</strong>{{ range $rule, $count := $rules }}: <code>{{ $rule }}</code> ×{{ $count }}{{ end }}</li>
            {{ end }}
          </ul>
        </details>
        {{ end }}
      </div>
      {{ end }}

      {{ if .Truncation.Truncated }}
      <div class="truncation-banner" role="status">
        <strong>Showing top {{ .Truncation.Shown }} of {{ .Truncation.Original }} findings.</strong>
        Re-run with <code>kubesplaining scan --all-findings</code> to include the full list, or raise the cap with <code>--max-findings={{ .Truncation.Original }}</code>.
      </div>
      {{ end }}

      {{ if .TopFixes }}
      <div class="section">
        <div class="section-hd">
          <h2>Fix these first</h2>
          <p>Each fix is one change to one identity or workload. Together they clear the most findings.</p>
        </div>
        <div class="card">
          <ol class="fix-list">
            {{ range .TopFixes }}
            <li class="fix">
              <span class="fix-rank">{{ .Rank }}</span>
              <span class="fix-action">{{ inlineHTML .Action }}</span>
              <span class="fix-impact">Clears {{ .FindingsCount }} {{ pluralize .FindingsCount "finding" "findings" }}, lowers the summed risk score by {{ score .ScoreImpact }}</span>
              {{ if .RuleIDs }}
              <details>
                <summary><svg class="chev"><use href="#i-chev"/></svg>{{ len .RuleIDs }} {{ pluralize (len .RuleIDs) "rule" "rules" }}</summary>
                <div class="rule-chips">{{ range .RuleIDs }}<a class="rule-chip" href="#finding-{{ . }}">{{ . }}</a>{{ end }}</div>
              </details>
              {{ end }}
            </li>
            {{ end }}
          </ol>
        </div>
      </div>
      {{ end }}

      {{ if .PrivescPaths.Groups }}
      <div class="section">
        <div class="section-hd">
          <h2>What an attacker can reach</h2>
          <a class="more" href="#tab-paths">See the attack paths graph →</a>
          <p>Each row is a high-value target and the number of identities that can reach it by chaining permissions.</p>
        </div>
        <div class="card">
          <table class="targets">
            <thead><tr><th>Target</th><th>Paths</th><th class="t-path">Most direct route</th><th></th></tr></thead>
            <tbody>
              {{ range .PrivescPaths.Groups }}
              <tr>
                <td class="t-name"><span class="dot {{ .SevClass }}"></span>{{ .SinkTitle }}</td>
                <td class="t-count">{{ .Count }}</td>
                <td class="t-path">{{ with index .Cards 0 }}<span class="chain">{{ range .Steps }}<span class="chain-node" title="{{ .Full }}">{{ .Label }}</span><span class="chain-edge">{{ .Action }}</span>{{ end }}</span>{{ end }}</td>
                <td class="t-go"><a href="#tab-paths?target={{ .SinkSlug }}">View →</a></td>
              </tr>
              {{ end }}
            </tbody>
          </table>
        </div>
      </div>
      {{ end }}

      {{ if .Narratives }}
      <div class="section">
        <div class="section-hd">
          <h2>Attack chains, in plain English</h2>
          <p>Findings that combine into a larger attack, explained step by step.</p>
        </div>
        <div class="card">
          {{ range $i, $n := .Narratives }}
          <details class="narr"{{ if eq $i 0 }} open{{ end }}>
            <summary><svg class="chev"><use href="#i-chev"/></svg><span class="sev {{ sevClass $n.Severity }}">{{ sevLabel $n.Severity }}</span><h3>{{ $n.Title }}</h3></summary>
            <div class="narr-body">
              <ol>
                {{ range $n.Steps }}<li>{{ .Text }}{{ if .Items }}<ul>{{ range .Items }}<li><code>{{ . }}</code></li>{{ end }}</ul>{{ end }}</li>{{ end }}
              </ol>
              {{ if $n.RuleIDs }}<div class="rule-chips">{{ range $n.RuleIDs }}<a class="rule-chip" href="#finding-{{ . }}">{{ . }}</a>{{ end }}</div>{{ end }}
            </div>
          </details>
          {{ end }}
        </div>
      </div>
      {{ end }}

      {{ if .Modules }}
      <div class="section">
        <div class="section-hd">
          <h2>Where the findings are</h2>
          <div class="legend" style="margin-left:auto"><span><i class="dot crit"></i>Critical</span><span><i class="dot high"></i>High</span><span><i class="dot med"></i>Medium</span><span><i class="dot low"></i>Low</span></div>
          <p>Click a row to open those findings.</p>
        </div>
        <div class="two-col">
          <div class="card">
            <h3 style="margin-bottom:10px">By attack type</h3>
            <div class="bars">
              {{ range .Categories }}
              <button type="button" class="bar-row" data-fl-target="category:{{ .CSSKey }}">
                <span class="bar-label">{{ .Label }}</span>
                <span class="bar">{{ if .Summary.Critical }}<span class="crit" style="flex:{{ .Summary.Critical }}"></span>{{ end }}{{ if .Summary.High }}<span class="high" style="flex:{{ .Summary.High }}"></span>{{ end }}{{ if .Summary.Medium }}<span class="med" style="flex:{{ .Summary.Medium }}"></span>{{ end }}{{ if .Summary.Low }}<span class="low" style="flex:{{ .Summary.Low }}"></span>{{ end }}</span>
                <span class="bar-n">{{ .Summary.Total }}</span>
              </button>
              {{ end }}
            </div>
          </div>
          <div class="card">
            <h3 style="margin-bottom:10px">By check module</h3>
            <div class="bars">
              {{ range .Modules }}
              <button type="button" class="bar-row" data-fl-target="module:{{ .ID }}">
                <span class="bar-label">{{ .Label }}</span>
                <span class="bar">{{ if .Summary.Critical }}<span class="crit" style="flex:{{ .Summary.Critical }}"></span>{{ end }}{{ if .Summary.High }}<span class="high" style="flex:{{ .Summary.High }}"></span>{{ end }}{{ if .Summary.Medium }}<span class="med" style="flex:{{ .Summary.Medium }}"></span>{{ end }}{{ if .Summary.Low }}<span class="low" style="flex:{{ .Summary.Low }}"></span>{{ end }}</span>
                <span class="bar-n">{{ .Summary.Total }}</span>
              </button>
              {{ end }}
            </div>
          </div>
        </div>
      </div>
      {{ end }}

      {{ if .Snapshot.Metadata.CollectionWarnings }}
      <div class="section">
        <div class="banner">
          <strong>Some data could not be collected,</strong> so a few checks may be missing.
          <details><summary>{{ len .Snapshot.Metadata.CollectionWarnings }} collection {{ pluralize (len .Snapshot.Metadata.CollectionWarnings) "warning" "warnings" }}</summary>
            <ul class="note-list">{{ range .Snapshot.Metadata.CollectionWarnings }}<li>{{ . }}</li>{{ end }}</ul>
          </details>
        </div>
      </div>
      {{ end }}

      <div class="section">
        <details class="card recon-card">
          <summary>
            <svg class="chev"><use href="#i-chev"/></svg>
            <h2>Cluster reconnaissance</h2>
            <span class="recon-chips">{{ range .Recon.HeadlineChips }}<span class="recon-chip recon-chip-{{ .Tone }}"><strong>{{ .Value }}</strong> {{ .Label }}</span>{{ end }}</span>
          </summary>
          <div class="recon-body">
            <section class="recon-section">
              <h3>Cluster shape</h3>
              {{ if .Recon.Shape.Distribution }}<div class="recon-row"><span class="recon-key">Distribution</span><span class="recon-val"><strong>{{ .Recon.Shape.Distribution }}</strong></span></div>{{ end }}
              {{ if .Recon.Shape.CloudLabel }}<div class="recon-row"><span class="recon-key">Cloud</span><span class="recon-val">{{ .Recon.Shape.CloudLabel }}</span></div>{{ end }}
              <div class="recon-row"><span class="recon-key">API server</span><span class="recon-val">{{ if .Recon.Shape.APIHost }}<code>{{ .Recon.Shape.APIHost }}</code>{{ end }}<span class="recon-tag {{ if eq .Recon.Shape.APIReachability "public" }}tag-danger{{ else if eq .Recon.Shape.APIReachability "private" }}tag-ok{{ end }}">{{ .Recon.Shape.APIReachability }}</span></span></div>
              <div class="recon-row"><span class="recon-key">Nodes</span><span class="recon-val"><strong>{{ .Recon.Shape.NodeCount }}</strong>{{ if .Recon.Shape.ArchBreakdown }} <span class="recon-more">{{ .Recon.Shape.ArchBreakdown }}</span>{{ end }}{{ if .Recon.Shape.OSImage }} <span class="recon-more">· {{ .Recon.Shape.OSImage }}</span>{{ end }}</span></div>
              {{ if .Recon.Shape.KubeletVersions }}<div class="recon-row"><span class="recon-key">Kubelet</span><span class="recon-val">{{ range .Recon.Shape.KubeletVersions }}<code>{{ . }}</code>{{ end }}</span></div>{{ end }}
              {{ if .Recon.Shape.RuntimeVersions }}<div class="recon-row"><span class="recon-key">Runtime</span><span class="recon-val">{{ range .Recon.Shape.RuntimeVersions }}<code>{{ . }}</code>{{ end }}</span></div>{{ end }}
              <div class="recon-row"><span class="recon-key">Inventory</span><span class="recon-val"><strong>{{ .Recon.Shape.NamespaceCount }}</strong> {{ pluralize .Recon.Shape.NamespaceCount "namespace" "namespaces" }} · <strong>{{ .Recon.Shape.PodCount }}</strong> {{ pluralize .Recon.Shape.PodCount "pod" "pods" }} · <strong>{{ .Recon.Shape.SACount }}</strong> {{ pluralize .Recon.Shape.SACount "service account" "service accounts" }}</span></div>
            </section>
            <section class="recon-section">
              <h3>Who already owns this cluster</h3>
              <div class="recon-row"><span class="recon-key">cluster-admin</span><span class="recon-val">{{ template "reconSubjectList" .Recon.Ownership.ClusterAdmins }}</span></div>
              <div class="recon-row"><span class="recon-key">Wildcard verbs</span><span class="recon-val">{{ template "reconSubjectList" .Recon.Ownership.WildcardVerbSubjects }}</span></div>
              <div class="recon-row"><span class="recon-key">Reads secrets</span><span class="recon-val">{{ template "reconSubjectList" .Recon.Ownership.SecretReaders }}</span></div>
              <div class="recon-row"><span class="recon-key">Escalation paths</span><span class="recon-val">
                {{ if gt .Recon.Ownership.PrivescToAdminCount 0 }}<a href="#{{ .Recon.Ownership.PrivescToAdminAnchor }}" class="recon-tag tag-danger">{{ .Recon.Ownership.PrivescToAdminCount }} → cluster-admin</a>{{ end }}
                {{ if gt .Recon.Ownership.NodeEscapeCount 0 }}<a href="#{{ .Recon.Ownership.NodeEscapeAnchor }}" class="recon-tag tag-danger">{{ .Recon.Ownership.NodeEscapeCount }} → node escape</a>{{ end }}
                {{ if and (eq .Recon.Ownership.PrivescToAdminCount 0) (eq .Recon.Ownership.NodeEscapeCount 0) }}<span class="recon-empty">none detected</span>{{ end }}
              </span></div>
            </section>
            <section class="recon-section">
              <h3>Exposed surface</h3>
              <div class="recon-row"><span class="recon-key">LoadBalancers</span><span class="recon-val">{{ template "reconResourceList" .Recon.Surface.LoadBalancers }}</span></div>
              <div class="recon-row"><span class="recon-key">NodePort / extIP</span><span class="recon-val"><strong>{{ .Recon.Surface.NodePorts }}</strong> NodePort · <strong>{{ .Recon.Surface.ExternalIPs }}</strong> externalIP</span></div>
              <div class="recon-row"><span class="recon-key">HostNetwork pods</span><span class="recon-val">{{ template "reconResourceList" .Recon.Surface.HostNetworkPods }}</span></div>
              <div class="recon-row"><span class="recon-key">Privileged pods</span><span class="recon-val">{{ template "reconResourceList" .Recon.Surface.PrivilegedPods }}</span></div>
              <div class="recon-row"><span class="recon-key">Mutating webhooks</span><span class="recon-val"><strong>{{ .Recon.Surface.MutatingWebhooks }}</strong>{{ if gt .Recon.Surface.OutOfClusterWebhooks 0 }} <span class="recon-tag tag-warn">{{ .Recon.Surface.OutOfClusterWebhooks }} out-of-cluster</span>{{ end }}</span></div>
            </section>
            <section class="recon-section">
              <h3>Guardrails</h3>
              <div class="recon-row"><span class="recon-key">NetworkPolicies</span><span class="recon-val"><strong>{{ .Recon.Guardrails.NetworkPolicies }}</strong> <span class="recon-more">across {{ .Recon.Guardrails.NamespacesProtected }} {{ pluralize .Recon.Guardrails.NamespacesProtected "namespace" "namespaces" }}</span>{{ if gt .Recon.Guardrails.NamespacesUnprotected 0 }} <span class="recon-tag tag-danger">{{ .Recon.Guardrails.NamespacesUnprotected }} unprotected</span>{{ end }}</span></div>
              <div class="recon-row"><span class="recon-key">Pod Security</span><span class="recon-val">{{ if .Recon.Guardrails.PSAEnforce }}{{ range $mode, $count := .Recon.Guardrails.PSAEnforce }}<span class="recon-tag {{ if eq $mode "restricted" }}tag-ok{{ else if eq $mode "baseline" }}tag-warn{{ else }}tag-danger{{ end }}">enforce={{ $mode }} ×{{ $count }}</span>{{ end }}{{ else }}<span class="recon-empty">no PSA labels</span>{{ end }}</span></div>
              <div class="recon-row"><span class="recon-key">Policy engines</span><span class="recon-val">{{ if .Recon.Guardrails.Engines }}{{ range .Recon.Guardrails.Engines }}<span class="recon-tag tag-ok">{{ . }}</span>{{ end }}{{ else }}<span class="recon-empty">none</span>{{ end }}</span></div>
              <div class="recon-row"><span class="recon-key">Default-SA pods</span><span class="recon-val"><strong>{{ .Recon.Guardrails.DefaultSATokenMounts }}</strong> <span class="recon-more">with token automount</span></span></div>
            </section>
            <details class="disc recon-prov">
              <summary><svg class="chev"><use href="#i-chev"/></svg>Collection details</summary>
              <div class="disc-body">
                {{ if .Recon.Provenance.CollectorIdentity }}<div class="recon-row"><span class="recon-key">Collector</span><span class="recon-val"><code>{{ .Recon.Provenance.CollectorIdentity }}</code></span></div>{{ end }}
                <div class="recon-row"><span class="recon-key">Permissions</span><span class="recon-val"><strong>{{ len .Recon.Provenance.PermissionsAvailable }}</strong> seen · <strong>{{ len .Recon.Provenance.PermissionsMissing }}</strong> missing</span></div>
                <div class="recon-row"><span class="recon-key">Namespaces scanned</span><span class="recon-val"><strong>{{ len .Recon.Provenance.NamespacesScanned }}</strong></span></div>
                {{ if .Recon.Provenance.CollectionDurationSec }}<div class="recon-row"><span class="recon-key">Duration</span><span class="recon-val">{{ printf "%.1fs" .Recon.Provenance.CollectionDurationSec }}</span></div>{{ end }}
                {{ if .Recon.Provenance.PermissionsMissing }}<div class="recon-row"><span class="recon-key">Missing permissions</span><span class="recon-val"><ul class="note-list">{{ range .Recon.Provenance.PermissionsMissing }}<li>{{ . }}</li>{{ end }}</ul></span></div>{{ end }}
              </div>
            </details>
          </div>
        </details>
      </div>
    </section>

    {{ if gt (len .PrivescPaths.Groups) 0 }}
    <!-- ======================= Attack paths ======================= -->
    <section class="panel" data-tab="paths" id="tab-paths" role="tabpanel" aria-labelledby="tabbtn-paths">
      <div class="panel-hd">
        <h1>Attack paths</h1>
        <p class="lede">An attack path is a chain of permissions. An attacker who controls the identity on the left can follow it, one hop at a time, to the target on the right. Select a target to see every identity that can reach it.</p>
        {{ if .MaxPrivescDepth }}<p class="dim" style="font-size:13px">The search went up to {{ .MaxPrivescDepth }} hops deep (<code>--max-privesc-depth</code>). Longer routes are not shown.</p>{{ end }}
      </div>

      <div class="target-picker" role="tablist" aria-label="Escalation targets">
        {{ range $i, $g := .PrivescPaths.Groups }}
        <button type="button" class="target-btn" role="tab" data-target="{{ $g.SinkSlug }}" aria-selected="{{ if eq $i 0 }}true{{ else }}false{{ end }}" aria-controls="target-{{ $g.SinkSlug }}"><span class="dot {{ $g.SevClass }}"></span>{{ $g.SinkTitle }} <span class="n">{{ $g.Count }}</span></button>
        {{ end }}
      </div>

      {{ range $gi, $g := .PrivescPaths.Groups }}
      <div class="target-view{{ if eq $gi 0 }} is-active{{ end }}" data-target-view="{{ $g.SinkSlug }}" id="target-{{ $g.SinkSlug }}">
        <div class="tv-hd">
          <h2>{{ $g.Count }} {{ pluralize $g.Count "path" "paths" }} to {{ $g.SinkTitle }}</h2>
          <span class="counts">{{ if $g.Summary.Critical }}<span class="sev crit">{{ $g.Summary.Critical }} critical</span>{{ end }}{{ if $g.Summary.High }}<span class="sev high">{{ $g.Summary.High }} high</span>{{ end }}{{ if $g.Summary.Medium }}<span class="sev med">{{ $g.Summary.Medium }} medium</span>{{ end }}{{ if $g.Summary.Low }}<span class="sev low">{{ $g.Summary.Low }} low</span>{{ end }}</span>
        </div>
        {{ if $g.Blurb }}<p class="tv-blurb">{{ $g.Blurb }}</p>{{ end }}

        {{ with $g.Graph }}
        {{ if .Skipped }}
        <p class="banner">This target has {{ .TotalNodes }} identities on its paths, too many to draw clearly. Every path is listed below.</p>
        {{ else }}
        <div class="card graph-card">
          <div class="graph-bar">
            <span class="graph-hint">Hover an identity or an arrow to trace its paths. Click to keep only those paths in the list.</span>
            <span class="focus-note">Showing paths through <strong data-focus-label></strong> <button type="button" data-clear-focus>Show all</button></span>
            <span class="legend"><span><i class="lg-line"></i>easy hop</span><span><i class="lg-line moderate"></i>moderate</span><span><i class="lg-line hard"></i>hard</span><span><i class="lg-box group"></i>group of identities</span><span><i class="lg-box sink"></i>intermediate target</span></span>
          </div>
          <div class="graph-scroll">
            {{ template "attack-graph" $g }}
          </div>
        </div>
        {{ end }}
        {{ end }}

        <div class="path-list">
          <div class="pl-hd"><h3>Paths</h3><span class="dim" data-path-count>{{ $g.Count }} {{ pluralize $g.Count "path" "paths" }}, worst first</span></div>
          {{ range $g.Cards }}
          <details class="path-row" data-path="{{ .Index }}">
            <summary>
              <svg class="chev"><use href="#i-chev"/></svg>
              <span class="sev {{ .SevClass }}">{{ sevLabel .Severity }}</span>
              <span class="chain">{{ range .Steps }}<span class="chain-node" title="{{ .Full }}">{{ .Label }}</span><span class="chain-edge">{{ .Action }}</span>{{ end }}<span class="chain-node target"{{ if .TerminalFull }} title="{{ .TerminalFull }}"{{ end }}>{{ $g.SinkTitle }}{{ if .Terminal }} · {{ .Terminal }}{{ end }}</span></span>
              <span class="path-meta">{{ .HopCount }} {{ pluralize .HopCount "hop" "hops" }} · score {{ printf "%.1f" .Score }}</span>
            </summary>
            <div class="path-body">
              <p class="path-source muted" style="margin-top:10px">Starts at <code>{{ .Source }}</code>.</p>
              {{ if .Hops }}{{ escalationPathHTML .Hops }}{{ if .AltHops }}<details class="alt-chain"><summary>{{ alternateSummaryLabel .AltHops .Hops }}</summary>{{ alternatePathHTML .AltHops .Hops }}</details>{{ end }}{{ end }}
              <a class="open-finding" href="#{{ .Anchor }}">How to fix: open the finding →</a>
            </div>
          </details>
          {{ end }}
        </div>
      </div>
      {{ end }}
    </section>
    {{ end }}

    {{ if .Modules }}
    <!-- ======================= Findings ======================= -->
    <section class="panel" data-tab="findings" id="tab-findings" role="tabpanel" aria-labelledby="tabbtn-findings">
      <div class="findings-layout">
        <aside class="f-side" aria-label="Filter findings">
          <div class="f-search">
            <input type="search" id="findings-search-input" placeholder="Search name, namespace, rule" aria-label="Search findings" autocomplete="off" spellcheck="false">
            <kbd aria-hidden="true">/</kbd>
          </div>
          <div>
            <div class="f-label">Severity</div>
            <div class="f-sev">
              {{ if .Summary.Critical }}<button type="button" class="f-opt" data-sev-toggle="crit" aria-pressed="false"><span class="dot crit"></span>Critical<span class="n">{{ .Summary.Critical }}</span></button>{{ end }}
              {{ if .Summary.High }}<button type="button" class="f-opt" data-sev-toggle="high" aria-pressed="false"><span class="dot high"></span>High<span class="n">{{ .Summary.High }}</span></button>{{ end }}
              {{ if .Summary.Medium }}<button type="button" class="f-opt" data-sev-toggle="med" aria-pressed="false"><span class="dot med"></span>Medium<span class="n">{{ .Summary.Medium }}</span></button>{{ end }}
              {{ if .Summary.Low }}<button type="button" class="f-opt" data-sev-toggle="low" aria-pressed="false"><span class="dot low"></span>Low<span class="n">{{ .Summary.Low }}</span></button>{{ end }}
              {{ if .Summary.Info }}<button type="button" class="f-opt" data-sev-toggle="info" aria-pressed="false"><span class="dot"></span>Info<span class="n">{{ .Summary.Info }}</span></button>{{ end }}
            </div>
          </div>
          <nav aria-label="Modules">
            <div class="f-label">Modules</div>
            <div class="f-sev">
              {{ range .Modules }}<a class="f-opt" href="#{{ .ID }}" data-module-link="{{ .ID }}">{{ .Label }}<span class="n">{{ .Summary.Total }}</span></a>{{ end }}
            </div>
          </nav>
          <div class="f-active findings-filters" hidden>
            <div class="f-label">Active filters</div>
            <div class="f-active" id="fl-active"></div>
            <button type="button" class="f-clear" id="fl-clear">Clear all filters</button>
          </div>
        </aside>

        <div class="f-main">
          <div class="f-status" id="f-status" aria-live="polite">{{ .Summary.Total }} {{ pluralize .Summary.Total "finding" "findings" }} in {{ len .Modules }} {{ pluralize (len .Modules) "module" "modules" }}. Click a rule to see the affected objects.</div>
          {{ range $module := .Modules }}
          <section class="module-section" data-module="{{ .ID }}" id="{{ .ID }}">
            <header><h2>{{ .Label }}</h2><span class="dim">{{ .Summary.Total }} {{ pluralize .Summary.Total "finding" "findings" }} · {{ len .RuleGroups }} {{ pluralize (len .RuleGroups) "rule" "rules" }}</span></header>
            {{ range $module.RuleGroups }}
            {{ $group := . }}
            <details class="rule-group sev-{{ sevClass .TopSeverity }}" id="{{ .Anchor }}" data-rule="{{ .RuleID }}" data-severity="{{ sevClass .TopSeverity }}">
              <summary class="rule-hd">
                <svg class="chev"><use href="#i-chev"/></svg>
                <span class="sev {{ sevClass .TopSeverity }}">{{ sevLabel .TopSeverity }}</span>
                <span class="rule-title">{{ inlineHTML .RuleTitle }}</span>
                <span class="rule-count">{{ .InstanceCount }} affected</span>
                <span class="score-badge" title="Risk score 0 to 10. Hover a single finding's score for its breakdown.">{{ score .MaxScore }}</span>
              </summary>
              <div class="rule-body">
                <div class="rule-meta">
                  <span class="mono">{{ .RuleID }}</span>
                  {{ if .MitreTechniques }}<span>MITRE ATT&amp;CK {{ range .MitreTechniques }}<a href="{{ .URL }}" target="_blank" rel="noopener noreferrer" title="{{ .Name }}">{{ .ID }}</a> {{ end }}</span>{{ end }}
                  {{ if .LearnMore }}
                  <details class="refs"><summary>References ({{ len .LearnMore }})</summary><ul>{{ range .LearnMore }}<li><a href="{{ .URL }}" target="_blank" rel="noopener noreferrer">{{ .Title }}</a></li>{{ end }}</ul></details>
                  {{ else if .References }}
                  <details class="refs"><summary>References ({{ len .References }})</summary><ul>{{ range .References }}<li><a href="{{ . }}" target="_blank" rel="noopener noreferrer">{{ . }}</a></li>{{ end }}</ul></details>
                  {{ end }}
                </div>
                {{ $edu := ruleEducationHTML .Findings }}
                {{ if $edu }}
                <details class="disc">
                  <summary><svg class="chev"><use href="#i-chev"/></svg>Background: the Kubernetes terms in this rule</summary>
                  <div class="disc-body">{{ $edu }}</div>
                </details>
                {{ end }}
                <div class="instances">
                  {{ if gt .InstanceCount 1 }}<div class="instances-hd">Affected ({{ .InstanceCount }})</div>{{ end }}
                  {{ range $i, $f := .Findings }}
                  <details class="instance finding"{{ if eq $group.InstanceCount 1 }} open{{ end }} data-rule="{{ $f.RuleID }}" data-severity="{{ sevClass $f.Severity }}" data-category="{{ catKey $f.Category }}"{{ if $f.Scope.Level }} data-scope="{{ $f.Scope.Level }}"{{ end }}{{ if $f.Resource }} data-resource="{{ resource $f.Resource }}"{{ end }}{{ if $f.Subject }} data-subject="{{ subject $f.Subject }}"{{ end }}{{ if $f.Namespace }} data-namespace="{{ $f.Namespace }}"{{ end }}>
                    <summary class="instance-hd">
                      <svg class="chev"><use href="#i-chev"/></svg>
                      <span class="dot {{ sevClass $f.Severity }}" title="{{ sevLabel $f.Severity }}"></span>
                      <span class="instance-title">{{ if $f.Subject }}{{ subjectCode $f.Subject }}{{ else if $f.Resource }}{{ resourceCode $f.Resource }}{{ else }}{{ inlineHTML $f.Title }}{{ end }}</span>
                      {{ if $f.Scope.Level }}<span class="instance-scope" title="Blast radius">{{ scopeLabel $f.Scope.Level }}</span>{{ end }}
                      <span class="score-badge" title="{{ scoringTooltipText $f }}">{{ score $f.Score }}</span>
                    </summary>
                    <div class="instance-body">
                      <h4 class="finding-title">{{ inlineHTML $f.Title }}</h4>
                      <div class="desc">{{ descriptionHTML $f.Description }}</div>
                      {{ if $f.Impact }}<p class="impact"><strong>Impact</strong>{{ inlineHTML $f.Impact }}</p>{{ end }}

                      {{ if or $f.Remediation $f.RemediationSteps $f.RemediationHint }}
                      <div class="fix-block rem">
                        <h5>How to fix</h5>
                        {{ if $f.Remediation }}<div>{{ inlineHTML $f.Remediation }}</div>{{ end }}
                        {{ if $f.RemediationSteps }}<ol>{{ range $f.RemediationSteps }}<li>{{ remediationStepHTML . }}</li>{{ end }}</ol>{{ end }}
                        {{ if $f.RemediationHint }}
                        <div class="rem-hint">
                          {{ with $f.RemediationHint.Patch }}
                          <details class="rem-patch" open>
                            <summary>kubectl patch ({{ .Type }}) <code>{{ .Target.Kind }}/{{ if .Target.Namespace }}{{ .Target.Namespace }}/{{ end }}{{ .Target.Name }}</code></summary>
                            {{ if .Command }}<pre><code>{{ .Command }}</code></pre>{{ end }}
                            {{ if .Body }}<pre><code>{{ json .Body }}</code></pre>{{ end }}
                          </details>
                          {{ end }}
                          {{ if $f.RemediationHint.KyvernoPolicy }}<details class="rem-kyverno"><summary>Kyverno ClusterPolicy (block at admission)</summary><pre><code>{{ $f.RemediationHint.KyvernoPolicy }}</code></pre></details>{{ end }}
                          {{ if $f.RemediationHint.GatekeeperPolicy }}<details class="rem-gatekeeper"><summary>Gatekeeper ConstraintTemplate (block at admission)</summary><pre><code>{{ $f.RemediationHint.GatekeeperPolicy }}</code></pre></details>{{ end }}
                          {{ if $f.RemediationHint.RBACDiff }}<details class="rem-rbac-diff"><summary>Smallest RBAC change that breaks the chain</summary><pre><code>{{ $f.RemediationHint.RBACDiff }}</code></pre></details>{{ end }}
                        </div>
                        {{ end }}
                      </div>
                      {{ end }}

                      {{ if or $f.AttackScenario $f.EscalationPath }}
                      <details class="disc scenario">
                        <summary><svg class="chev"><use href="#i-chev"/></svg>How an attacker uses this</summary>
                        <div class="disc-body">
                          {{ if $f.AttackScenario }}<ol class="attack-narrative">{{ range $f.AttackScenario }}<li>{{ inlineHTML . }}</li>{{ end }}</ol>{{ end }}
                          {{ if $f.EscalationPath }}
                          {{ escalationPathHTML $f.EscalationPath }}
                          {{ if $f.AlternateEscalationPath }}<details class="alt-chain"><summary>{{ alternateSummaryLabel $f.AlternateEscalationPath $f.EscalationPath }}</summary>{{ alternatePathHTML $f.AlternateEscalationPath $f.EscalationPath }}</details>{{ end }}
                          {{ end }}
                        </div>
                      </details>
                      {{ end }}

                      {{ $ev := evidenceHTML $f.Evidence }}
                      {{ if $ev }}
                      <details class="disc evidence">
                        <summary><svg class="chev"><use href="#i-chev"/></svg>Evidence</summary>
                        <div class="disc-body">
                          {{ $ev }}
                          <details class="evidence-raw"><summary>Show raw JSON</summary><pre><code>{{ json $f.Evidence }}</code></pre></details>
                        </div>
                      </details>
                      {{ end }}

                      <div class="facts">
                        <span>Type: {{ catLabel $f.Category }}</span>
                        {{ if and $f.Subject $f.Resource }}<span>Resource: {{ resourceCode $f.Resource }}</span>{{ end }}
                        {{ if $f.Namespace }}<span>Namespace: <code>{{ $f.Namespace }}</code></span>{{ end }}
                        {{ if $f.Scope.Detail }}<span>Blast radius: {{ scopeDetailHTML $f.Scope.Detail }}</span>{{ end }}
                      </div>
                    </div>
                  </details>
                  {{ end }}
                </div>
              </div>
            </details>
            {{ end }}
          </section>
          {{ end }}
          <p class="f-empty" id="f-empty" hidden>No findings match these filters.</p>
        </div>
      </div>
    </section>
    {{ end }}
    {{ end }}

    <!-- ======================= Least privilege ======================= -->
    <section class="panel" data-tab="leastprivilege" id="tab-leastprivilege" role="tabpanel" aria-labelledby="tabbtn-leastprivilege">
      <div class="panel-hd">
        <h1>Least privilege</h1>
        <p class="lede">RBAC grants that look broader than the workload needs. Each item is a recommendation, not an exploit. Before you remove a permission, make sure the audit window covers a full cycle of the workload.</p>
        {{ if .LeastPrivilege.HasAuditData }}
        <div class="lp-window"><span><strong>Audit window</strong> {{ .LeastPrivilege.WindowStart }} → {{ .LeastPrivilege.WindowEnd }}</span><span>{{ .LeastPrivilege.WindowDays }} days</span><span>{{ .LeastPrivilege.EventsProcessed }} events</span></div>
        {{ end }}
      </div>

      {{ if not .LeastPrivilege.HasAuditData }}
      <div class="banner">
        <strong>No audit log supplied.</strong> The usage-based checks (<code>KUBE-RBAC-UNUSED-*</code>, <code>KUBE-RBAC-WILDCARD-USED-PARTIAL-*</code>) need <code>--audit-log &lt;path&gt;</code>. Without it, only static checks such as stale bindings appear here. See <code>docs/audit-logs.md</code> for setup.
        <pre><code>kubesplaining scan --input-file snapshot.json \
  --audit-log ./audit.log \
  --audit-window-days 30 \
  --least-privilege-only</code></pre>
      </div>
      {{ end }}

      {{ if eq .LeastPrivilege.Total 0 }}
      <div class="card lp-empty"><strong>No least-privilege opportunities found.</strong> <span class="muted">Either the Roles are tightly scoped, or the audit window had too little activity. Try a wider <code>--audit-window-days</code> to confirm.</span></div>
      {{ else }}

      {{ if .LeastPrivilege.HasAuditData }}{{ if gt .LeastPrivilege.NonSAUsernames 0 }}
      <div class="banner"><strong>Note:</strong> {{ .LeastPrivilege.NonSAUsernames }} non-ServiceAccount callers (humans, groups, kubelets) made API calls in this window. Only ServiceAccount RBAC is analyzed here. Review human access through your identity provider.</div>
      {{ end }}{{ end }}

      {{ if .LeastPrivilege.UnusedResources }}
      <details class="card lp-table-wrap" open>
        <summary><svg class="chev"><use href="#i-chev"/></svg><h3>Unused RBAC objects</h3><span class="dim">{{ len .LeastPrivilege.UnusedResources }}</span></summary>
        <p class="lp-table-sub">Roles, ClusterRoles, and bindings that look safe to delete.</p>
        <div class="table-scroll">
          <table class="lp-table">
            <thead><tr><th>Severity</th><th>Role and ServiceAccount</th><th>What to do</th></tr></thead>
            <tbody>
              {{ range .LeastPrivilege.UnusedResources }}
              <tr>
                <td><span class="sev {{ sevClass .Severity }}">{{ sevLabel .Severity }}</span><div class="sev-rule"><code>{{ .RuleID }}</code></div></td>
                <td><div><span class="lp-bind-label">Role:</span> <code>{{ .Resource }}</code></div><div><span class="lp-bind-label">ServiceAccount:</span> {{ if .Subject }}<code>{{ .Subject }}</code>{{ else }}<span class="lp-na">-</span>{{ end }}</div></td>
                <td><div class="lp-action">{{ .Action }}</div><div class="lp-action-why">{{ .Why }}</div></td>
              </tr>
              {{ end }}
            </tbody>
          </table>
        </div>
      </details>
      {{ end }}

      {{ if .LeastPrivilege.RoleVerbMap }}
      <details class="card lp-table-wrap" open>
        <summary><svg class="chev"><use href="#i-chev"/></svg><h3>Verbs to remove</h3><span class="dim">{{ len .LeastPrivilege.RoleVerbMap }}</span></summary>
        <p class="lp-table-sub">"Used" lists the verbs the workload called in the audit window. "Unused" lists the verbs the Role still grants with no sign of need.</p>
        <div class="table-scroll">
          <table class="lp-table">
            <thead><tr><th>Severity</th><th>Role and ServiceAccount</th><th>Used</th><th>Unused</th><th>What to do</th></tr></thead>
            <tbody>
              {{ range .LeastPrivilege.RoleVerbMap }}
              <tr>
                <td><span class="sev {{ sevClass .Severity }}">{{ sevLabel .Severity }}</span><div class="sev-rule"><code>{{ .RuleID }}</code></div></td>
                <td><div><span class="lp-bind-label">Role:</span> <code>{{ .Role }}</code></div><div><span class="lp-bind-label">ServiceAccount:</span> {{ if .Subject }}<code>{{ .Subject }}</code>{{ else }}<span class="lp-na">-</span>{{ end }}</div></td>
                <td class="lp-cell-used">{{ .UsedVerbs }}</td>
                <td class="lp-cell-unused">{{ .UnusedVerbs }}</td>
                <td><div class="lp-action">{{ .Action }}</div></td>
              </tr>
              {{ end }}
            </tbody>
          </table>
        </div>
      </details>
      {{ end }}

      {{ if .LeastPrivilege.ClusterAdminInventory }}
      <details class="card lp-table-wrap">
        <summary><svg class="chev"><use href="#i-chev"/></svg><h3>Subjects bound to cluster-admin</h3><span class="dim">{{ len .LeastPrivilege.ClusterAdminInventory }}</span></summary>
        <p class="lp-table-sub">An inventory, not a list of findings. <span class="lp-tag lp-tag-system">built-in</span> rows are expected. <span class="lp-tag lp-tag-review">review</span> rows are grants someone chose to make: check that each one is still needed.</p>
        <div class="table-scroll">
          <table class="lp-table">
            <thead><tr><th>Subject</th><th>ClusterRoleBinding</th><th>Type</th></tr></thead>
            <tbody>
              {{ range .LeastPrivilege.ClusterAdminInventory }}
              <tr{{ if .IsSystem }} class="lp-row-system"{{ end }}>
                <td><span class="lp-subj-kind">{{ .SubjectKind }}</span><code>{{ if .SubjectNs }}{{ .SubjectNs }}/{{ end }}{{ .SubjectName }}</code></td>
                <td><code>{{ .Binding }}</code></td>
                <td>{{ if .IsSystem }}<span class="lp-tag lp-tag-system">built-in</span>{{ else }}<span class="lp-tag lp-tag-review">review</span>{{ end }}</td>
              </tr>
              {{ end }}
            </tbody>
          </table>
        </div>
      </details>
      {{ end }}

      {{ if .SubjectCapCards }}
      <div class="section">
        <div class="section-hd">
          <h2>What each identity can do</h2>
          <p>One card per identity with a finding or a cluster-admin-level grant. Cards marked <span class="badge-chain">attack path</span> start an escalation path: prune those first.</p>
        </div>
        <div class="cap-grid">
          {{ range .SubjectCapCards }}
          <article class="cap-card sev-{{ sevClass .HighestSeverity }}">
            <h3>{{ .SubjectLabel }}{{ if .ChainAmplified }}<span class="badge-chain" title="An escalation path starts at this identity">attack path</span>{{ end }}</h3>
            {{ if .Bindings }}<h4>Bindings</h4><ul>{{ range .Bindings }}<li><code>{{ . }}</code></li>{{ end }}</ul>{{ end }}
            {{ if .EffectiveVerbs }}<h4>Verbs</h4><div>{{ range .EffectiveVerbs }}<code>{{ . }}</code> {{ end }}</div>{{ end }}
            {{ if .EffectiveRules }}<h4>Rules</h4><ul>{{ range .EffectiveRules }}<li><code>{{ . }}</code></li>{{ end }}</ul>{{ end }}
            {{ if .PrivescPaths }}<h4>Escalation paths from here</h4><ul>{{ range .PrivescPaths }}<li>{{ . }}</li>{{ end }}</ul>{{ end }}
          </article>
          {{ end }}
        </div>
      </div>
      {{ end }}

      {{ if .LeastPrivilege.Groups }}
      <div class="section">
        <div class="section-hd"><h2>Findings by identity</h2></div>
        {{ range .LeastPrivilege.Groups }}
        <details class="lp-group">
          <summary>
            <svg class="chev"><use href="#i-chev"/></svg>
            <span class="dim">{{ .SubjectKind }}</span> <span class="mono">{{ if .SubjectNs }}{{ .SubjectNs }}/{{ end }}{{ .SubjectName }}</span>
            <span class="counts">{{ if gt .Summary.Critical 0 }}<span class="sev crit">{{ .Summary.Critical }} critical</span>{{ end }}{{ if gt .Summary.High 0 }}<span class="sev high">{{ .Summary.High }} high</span>{{ end }}{{ if gt .Summary.Medium 0 }}<span class="sev med">{{ .Summary.Medium }} medium</span>{{ end }}{{ if gt .Summary.Low 0 }}<span class="sev low">{{ .Summary.Low }} low</span>{{ end }}</span>
          </summary>
          {{ range .Cards }}
          <div class="lp-finding">
            <div class="lp-finding-hd"><span class="sev {{ sevClass .Finding.Severity }}">{{ sevLabel .Finding.Severity }}</span><span>{{ inlineHTML .Finding.Title }}</span><span class="mono">{{ .Finding.RuleID }}</span></div>
            <div class="desc">{{ descriptionHTML .Finding.Description }}</div>
            {{ if .Finding.RemediationSteps }}
            <details class="disc"><summary><svg class="chev"><use href="#i-chev"/></svg>How to fix ({{ len .Finding.RemediationSteps }} steps)</summary><div class="disc-body"><ol>{{ range .Finding.RemediationSteps }}<li>{{ remediationStepHTML . }}</li>{{ end }}</ol></div></details>
            {{ else if .Finding.Remediation }}
            <details class="disc"><summary><svg class="chev"><use href="#i-chev"/></svg>How to fix</summary><div class="disc-body">{{ inlineHTML .Finding.Remediation }}</div></details>
            {{ end }}
            {{ if .SuggestedRoleYAML }}
            <details class="disc lp-yaml"><summary><svg class="chev"><use href="#i-chev"/></svg>Suggested narrower Role (YAML)</summary><div class="disc-body"><pre><code>{{ .SuggestedRoleYAML }}</code></pre></div></details>
            {{ end }}
          </div>
          {{ end }}
        </details>
        {{ end }}
      </div>
      {{ end }}
      {{ end }}
    </section>

    {{ if and (not .LeastPrivilegeOnly) (gt (len .Compliance.Frameworks) 0) }}
    <!-- ======================= Compliance ======================= -->
    <section class="panel" data-tab="compliance" id="tab-compliance" role="tabpanel" aria-labelledby="tabbtn-compliance">
      <div class="panel-hd">
        <h1>Compliance</h1>
        <p class="lede">Findings mapped to the <strong>CIS Kubernetes Benchmark v1.9</strong> and the <strong>NSA/CISA Kubernetes Hardening Guide v1.2</strong>. One finding can map to several controls. Click a control to see its findings.</p>
        {{ if gt .Compliance.UnmappedCount 0 }}<p class="dim" style="font-size:13px">{{ .Compliance.UnmappedCount }} {{ pluralize .Compliance.UnmappedCount "finding is" "findings are" }} not mapped to any control. They still show on the other tabs.</p>{{ end }}
      </div>
      {{ range .Compliance.Frameworks }}
      <section class="cf-framework cf-{{ .CSSKey }}">
        <div class="cf-hd">
          <span class="cf-badge">{{ .ShortName }}</span>
          <h2>{{ .Name }}</h2>
          <span class="dim">{{ len .Controls }} {{ pluralize (len .Controls) "control" "controls" }} · {{ .Summary.Total }} {{ pluralize .Summary.Total "finding" "findings" }}</span>
          {{ if .URL }}<a href="{{ .URL }}" target="_blank" rel="noopener">Framework →</a>{{ end }}
        </div>
        {{ range .Controls }}
        <details class="cf-control sev-{{ sevClass .TopSeverity }}">
          <summary>
            <svg class="chev"><use href="#i-chev"/></svg>
            <span class="cf-id">{{ .Control }}</span>
            <span class="cf-title">{{ .Title }}</span>
            <span class="counts">{{ if gt .Summary.Critical 0 }}<span class="sev crit">{{ .Summary.Critical }}</span>{{ end }}{{ if gt .Summary.High 0 }}<span class="sev high">{{ .Summary.High }}</span>{{ end }}{{ if gt .Summary.Medium 0 }}<span class="sev med">{{ .Summary.Medium }}</span>{{ end }}{{ if gt .Summary.Low 0 }}<span class="sev low">{{ .Summary.Low }}</span>{{ end }}{{ if gt .Summary.Info 0 }}<span class="sev info">{{ .Summary.Info }}</span>{{ end }}</span>
          </summary>
          <ul class="cf-findings">
            {{ range .Findings }}
            <li><span class="dot {{ sevClass .Severity }}" title="{{ sevLabel .Severity }}"></span><a class="rule-chip" href="#finding-{{ .RuleID }}">{{ .RuleID }}</a><span>{{ inlineHTML .Title }}</span></li>
            {{ end }}
          </ul>
        </details>
        {{ end }}
      </section>
      {{ end }}
    </section>
    {{ end }}

    <p class="footer">Kubesplaining{{ if .Snapshot.Metadata.KubesplainingVersion }} {{ .Snapshot.Metadata.KubesplainingVersion }}{{ end }} · {{ .Summary.Total }} {{ pluralize .Summary.Total "finding" "findings" }} · {{ len .Modules }} {{ pluralize (len .Modules) "module" "modules" }}</p>
  </main>

  <div class="tip" id="kp-tip" hidden role="tooltip"></div>
  <script type="application/json" id="kp-glossary">{{ .GlossaryJSON }}</script>
  <script>{{ .Script }}</script>
</body>

{{- define "reconSubjectList" -}}
{{ if eq .Total 0 }}<span class="recon-empty">none</span>{{ else }}<strong>{{ .Total }}</strong>{{ range .Sample }} <code>{{ . }}</code>{{ end }}{{ if gt .MoreCount 0 }} <span class="recon-more">{{ if .Anchor }}<a href="#{{ .Anchor }}">+{{ .MoreCount }} more</a>{{ else }}+{{ .MoreCount }} more{{ end }}</span>{{ end }}{{ end }}
{{- end -}}

{{- define "reconResourceList" -}}
{{ if eq .Total 0 }}<span class="recon-empty">none</span>{{ else }}<strong>{{ .Total }}</strong>{{ range .Sample }} <code>{{ . }}</code>{{ end }}{{ if gt .MoreCount 0 }} <span class="recon-more">+{{ .MoreCount }} more</span>{{ end }}{{ end }}
{{- end -}}
