    /* --- Findings ---------------------------------------------------------- */
    .findings-layout { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 28px; align-items: start; }
    .f-side { position: sticky; top: calc(var(--topbar-h) + 16px); max-height: calc(100vh - var(--topbar-h) - 32px); overflow-y: auto; overflow-x: hidden; display: flex; flex-direction: column; gap: 20px; padding: 0 8px 8px; margin: 0 -8px; }
    .f-search { position: relative; }
    .f-search input { width: 100%; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; color: var(--text); padding: 8px 32px 8px 12px; font: inherit; font-size: 14px; }
    .f-search input::placeholder { color: var(--text-3); }
    .f-search input:focus { outline: none; border-color: var(--accent); }
    .f-search kbd { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); font-family: var(--mono); font-size: 11px; color: var(--text-3); border: 1px solid var(--line); border-radius: 4px; padding: 0 5px; }
