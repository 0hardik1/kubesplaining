{{ define "attack-graph" }}{{ $g := . }}{{ with .Graph }}<svg class="ap-svg" viewBox="0 0 {{ .Width }} {{ .Height }}" style="max-width:{{ .Width }}px" role="img" aria-label="Attack paths to {{ $g.SinkTitle }}">
<rect class="ap-bg" width="{{ .Width }}" height="{{ .Height }}"/>
<g class="ap-lanes">{{ range $ci, $c := .Columns }}<rect class="ap-lane{{ if eq (add $ci 1) (len $g.Graph.Columns) }} target{{ end }}" x="{{ $c.X }}" y="10" width="{{ $c.W }}" height="{{ sub $g.Graph.Height 20 }}" rx="16"/><text class="ap-col" x="{{ add $c.X (div $c.W 2) }}" y="34" text-anchor="middle">{{ $c.Label }}</text>{{ end }}</g>
<g class="ap-edges">{{ range .Edges }}<path class="ap-edge {{ .Difficulty }}" d="{{ .D }}" stroke-width="{{ .Width }}" data-paths="{{ .Paths }}"/><path class="ap-arrow" d="{{ .Arrow }}" data-paths="{{ .Paths }}"/><path class="ap-flow" d="{{ .D }}" data-paths="{{ .Paths }}"/><path class="ap-hit" d="{{ .D }}" data-paths="{{ .Paths }}" data-label="the hop “{{ .Label }}”"><title>{{ .Label }}</title></path>{{ end }}</g>
<g class="ap-nodes">{{ range .Nodes }}<g class="ap-node {{ .Kind }} {{ .SevClass }} c{{ .Col }}" transform="translate({{ .X }},{{ .Y }})" data-node="{{ .ID }}" data-paths="{{ .Paths }}" data-label="{{ .Tip }}" data-kind="{{ .KindLabel }}" data-sev="{{ .SevClass }}" data-count="{{ .PathCount }}"{{ if .Members }} data-members="{{ .Members }}"{{ end }} tabindex="0" role="button" aria-label="{{ .Tip }}"><title>{{ .Tip }}: {{ .KindLabel }}</title><g class="ap-in">{{ if eq .Kind "target" }}<rect class="ap-glow" x="-4" y="-4" width="{{ add .W 8 }}" height="{{ add .H 8 }}" rx="18"/>{{ end }}{{ if eq .Kind "group" }}<rect class="ap-stack" x="8" y="-8" width="{{ .W }}" height="{{ .H }}" rx="11"/><rect class="ap-stack" x="4" y="-4" width="{{ .W }}" height="{{ .H }}" rx="11"/>{{ end }}<rect class="ap-box" width="{{ .W }}" height="{{ .H }}" rx="11"/><rect class="ap-sheen" width="{{ .W }}" height="{{ .H }}" rx="11"/><rect class="ap-tile" x="11" y="{{ .TileY }}" width="26" height="26" rx="7"/><use class="ap-icon" href="#i-{{ .Icon }}" x="16" y="{{ add .TileY 5 }}" width="16" height="16"/><text class="ap-title" x="{{ .TextX }}" y="{{ .TitleY }}">{{ .Title }}</text><text class="ap-sub" x="{{ .TextX }}" y="{{ .SubY }}">{{ .Sub }}</text></g></g>{{ end }}</g>
<g class="ap-labels">{{ range .Edges }}<g class="ap-elabel" transform="translate({{ .LX }},{{ .LY }})" data-paths="{{ .Paths }}"><rect x="{{ sub 0 (div .LW 2) }}" y="-10" width="{{ .LW }}" height="20" rx="10"/><text y="4" text-anchor="middle">{{ .Short }}</text></g>{{ end }}</g>
</svg>{{ end }}{{ end }}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Kubesplaining Report{{ if .Snapshot.Metadata.ClusterName }}: {{ .Snapshot.Metadata.ClusterName }}{{ end }}</title>
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline';">
  <style>
    :root {
      --bg: #0b0f18; --surface: #121927; --surface-2: #182132; --surface-3: #1f2a3f;
      --line: #243049; --line-soft: #1b2436; --line-strong: #34425f;
      --text: #e8ecf4; --text-2: #aab4c8; --text-3: #7a869e;
      --accent: #74b8ff; --accent-soft: rgba(116,184,255,0.14);
      --crit: #ff5d6c; --crit-soft: rgba(255,93,108,0.14);
      --high: #ff9d4a; --high-soft: rgba(255,157,74,0.14);
      --med: #f0c94b; --med-soft: rgba(240,201,75,0.13);
      --low: #4fd1a1; --low-soft: rgba(79,209,161,0.13);
      --info: #8aa0bf; --info-soft: rgba(138,160,191,0.13);
      --mono: "JetBrains Mono", "SF Mono", Menlo, Consolas, monospace;
      --sans: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      --radius: 12px;
      --topbar-h: 104px;
    }
    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    html { scroll-padding-top: calc(var(--topbar-h) + 12px); }
    html, body { margin: 0; padding: 0; }
    body { background: var(--bg); color: var(--text); font: 14.5px/1.6 var(--sans); -webkit-font-smoothing: antialiased; font-feature-settings: "tnum" 1; overflow-x: clip; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    h1, h2, h3, h4, h5 { margin: 0; font-weight: 600; letter-spacing: -0.01em; line-height: 1.3; }
    h1 { font-size: 26px; letter-spacing: -0.02em; }
    h2 { font-size: 18px; }
    h3 { font-size: 15px; }
    h4 { font-size: 14px; }
    p { margin: 0 0 10px; }
    p:last-child { margin-bottom: 0; }
    ul, ol { margin: 0 0 10px; padding-left: 22px; }
    li { margin: 3px 0; }
    code, pre, .mono { font-family: var(--mono); font-size: 12.5px; }
    code { background: rgba(255,255,255,0.07); border-radius: 4px; padding: 1px 4px; overflow-wrap: anywhere; }
    pre { margin: 8px 0 0; background: #0a0e17; color: #c8d2e4; border: 1px solid var(--line-soft); border-radius: 8px; padding: 12px 14px; overflow-x: auto; line-height: 1.55; }
    pre code { background: none; padding: 0; overflow-wrap: normal; }
    strong { font-weight: 600; color: var(--text); }
    .muted { color: var(--text-2); }
    .dim { color: var(--text-3); }
    .wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
    button { font: inherit; color: inherit; }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    /* Glossary terms: dotted underline, definition on hover or focus. */
    code.gloss { cursor: help; text-decoration: underline dotted rgba(116,184,255,0.6); text-underline-offset: 3px; }

    /* Shared disclosure: <details class="disc"> with a chevron that turns. */
    details > summary { cursor: pointer; list-style: none; }
    details > summary::-webkit-details-marker { display: none; }
    .chev { flex: none; width: 16px; height: 16px; color: var(--text-3); transition: transform 0.15s ease; }
    details[open] > summary .chev { transform: rotate(90deg); }
    details.disc { margin-top: 12px; }
    details.disc > summary { display: inline-flex; align-items: center; gap: 6px; color: var(--text-2); font-size: 13.5px; font-weight: 600; }
    details.disc > summary:hover { color: var(--text); }
    details.disc > .disc-body { margin-top: 10px; padding-left: 22px; }

    /* Severity: a pill for labels, a dot for compact rows. */
    .sev { display: inline-flex; align-items: center; flex: none; font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; padding: 2px 8px; border-radius: 999px; line-height: 1.5; }
    .sev.crit { color: var(--crit); background: var(--crit-soft); }
    .sev.high { color: var(--high); background: var(--high-soft); }
    .sev.med { color: var(--med); background: var(--med-soft); }
    .sev.low { color: var(--low); background: var(--low-soft); }
    .sev.info { color: var(--info); background: var(--info-soft); }
    .dot { display: inline-block; flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--info); }
    .dot.crit { background: var(--crit); } .dot.high { background: var(--high); } .dot.med { background: var(--med); } .dot.low { background: var(--low); }
    .counts { display: inline-flex; flex-wrap: wrap; gap: 6px; }
    .counts .sev { text-transform: none; letter-spacing: 0; font-weight: 600; }

    /* --- Top bar and tabs -------------------------------------------------- */
    .topbar { position: sticky; top: 0; z-index: 20; background: rgba(11,15,24,0.94); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line-soft); }
    .topbar-row { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; padding-top: 14px; padding-bottom: 10px; }
    .brand { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 15px; }
    .brand-mark { width: 28px; height: 28px; border-radius: 8px; background: linear-gradient(135deg, #74b8ff, #b58cff); color: #0b0f18; display: grid; place-items: center; font-weight: 800; font-size: 14px; }
    .brand-sub { color: var(--text-3); font-weight: 400; }
    .meta { margin-left: auto; display: flex; flex-wrap: wrap; gap: 4px 16px; color: var(--text-3); font-size: 13px; }
    .meta strong { color: var(--text-2); font-weight: 500; }
    .tabs { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; }
    .tabs::-webkit-scrollbar { display: none; }
    .tab { background: none; border: 0; border-bottom: 2px solid transparent; padding: 8px 12px 10px; color: var(--text-2); font-size: 14px; font-weight: 600; cursor: pointer; white-space: nowrap; display: inline-flex; gap: 8px; align-items: center; }
    .tab:hover { color: var(--text); }
    .tab[aria-selected="true"] { color: var(--text); border-bottom-color: var(--accent); }
    .tab .n { font-size: 12px; font-weight: 600; color: var(--text-3); background: rgba(255,255,255,0.06); padding: 0 7px; border-radius: 999px; }
    .tab[aria-selected="true"] .n { color: var(--accent); background: var(--accent-soft); }
    /* Without JS every panel is shown in a row, so the tab bar would do nothing. */
    html:not(.js) .tabs { display: none; }

    main { padding: 28px 0 64px; }
    .js .panel { display: none; }
    .js .panel.is-active { display: block; }
    html:not(.js) .panel + .panel { margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--line); }
    .panel-hd { margin-bottom: 20px; max-width: 80ch; }
    .panel-hd h1 { margin-bottom: 6px; }
    .lede { color: var(--text-2); font-size: 15px; }

    .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 22px; }
    .card + .card, .section + .section { margin-top: 20px; }
    .section { margin-top: 32px; }
    .section-hd { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
    .section-hd p { flex-basis: 100%; color: var(--text-2); margin: 0; }
    .section-hd .more { margin-left: auto; font-size: 13.5px; font-weight: 600; }
    .banner, .truncation-banner { border: 1px solid var(--line); border-left: 3px solid var(--accent); background: var(--surface); border-radius: 8px; padding: 10px 14px; margin-top: 12px; color: var(--text-2); font-size: 13.5px; }
    .truncation-banner { border-left-color: var(--med); }
    .banner details { margin-top: 6px; }
    .banner summary { color: var(--accent); font-size: 13px; }
    .note-list { margin: 0; color: var(--text-2); }

    /* --- Summary ----------------------------------------------------------- */
    .hero { display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: start; }
    .hero h1 { font-size: 28px; margin-bottom: 8px; }
    .score { min-width: 150px; text-align: right; }
    .score-num { font-size: 40px; font-weight: 700; letter-spacing: -0.03em; line-height: 1; }
    .score-num span { font-size: 15px; color: var(--text-3); font-weight: 500; margin-left: 3px; }
    .score-lbl { margin-top: 6px; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
    .score.critical .score-num, .score.critical .score-lbl, .score.high .score-num, .score.high .score-lbl { color: var(--crit); }
    .score.moderate .score-num, .score.moderate .score-lbl { color: var(--high); }
    .score.low .score-num, .score.low .score-lbl { color: var(--low); }
    .score-why { margin-top: 4px; font-size: 12px; color: var(--text-3); }
    .sev-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 20px; }
    .sev-tile { display: flex; align-items: baseline; gap: 10px; background: var(--surface); border: 1px solid var(--line); border-top: 3px solid var(--info); border-radius: 10px; padding: 12px 16px; cursor: pointer; text-align: left; }
    .sev-tile:hover { border-color: var(--line-strong); }
    .sev-tile .n { font-size: 26px; font-weight: 700; letter-spacing: -0.02em; line-height: 1; }
    .sev-tile .l { color: var(--text-2); font-size: 13px; font-weight: 600; }
    .sev-tile.crit { border-top-color: var(--crit); } .sev-tile.crit .n { color: var(--crit); }
    .sev-tile.high { border-top-color: var(--high); } .sev-tile.high .n { color: var(--high); }
    .sev-tile.med { border-top-color: var(--med); } .sev-tile.med .n { color: var(--med); }
    .sev-tile.low { border-top-color: var(--low); } .sev-tile.low .n { color: var(--low); }

    .fix-list { list-style: none; margin: 0; padding: 0; }
    .fix { display: grid; grid-template-columns: 28px 1fr; gap: 4px 12px; padding: 14px 0; border-top: 1px solid var(--line-soft); }
    .fix:first-child { border-top: 0; padding-top: 4px; }
    .fix-rank { width: 26px; height: 26px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); font-size: 13px; font-weight: 700; display: grid; place-items: center; }
    .fix-action { font-weight: 500; }
    .fix-impact { grid-column: 2; color: var(--text-3); font-size: 13px; }
    .fix details { grid-column: 2; margin-top: 2px; }
    .fix details > summary { color: var(--text-3); font-size: 13px; display: inline-flex; align-items: center; gap: 4px; }
    .fix details > summary:hover { color: var(--text-2); }
    .fix .rule-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
    .rule-chip { font-family: var(--mono); font-size: 11.5px; color: var(--text-2); background: var(--surface-2); border: 1px solid var(--line); border-radius: 6px; padding: 1px 6px; }
    a.rule-chip:hover { color: var(--text); text-decoration: none; border-color: var(--line-strong); }

    .targets { width: 100%; border-collapse: collapse; }
    .targets th { text-align: left; font-size: 12px; font-weight: 600; color: var(--text-3); padding: 0 12px 8px 0; }
    .targets td { padding: 12px 12px 12px 0; border-top: 1px solid var(--line-soft); vertical-align: top; }
    .targets td.t-name { white-space: nowrap; font-weight: 600; }
    .targets td.t-name .dot { margin-right: 8px; position: relative; top: -1px; }
    .targets td.t-count { white-space: nowrap; color: var(--text-2); }
    .targets td.t-go { text-align: right; white-space: nowrap; font-size: 13.5px; font-weight: 600; padding-right: 0; }

    .narr { border-top: 1px solid var(--line-soft); }
    .narr:first-of-type { border-top: 0; }
    .narr > summary { display: flex; align-items: center; gap: 10px; padding: 12px 0; }
    .narr > summary h3 { font-size: 14.5px; }
    .narr-body { padding: 0 0 14px 26px; color: var(--text-2); }
    .narr-body ol { padding-left: 20px; }
    .narr-body ul { padding-left: 18px; margin-top: 4px; }
    .narr-body .rule-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }

    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .bars { display: flex; flex-direction: column; gap: 4px; }
    .bar-row { display: grid; grid-template-columns: 150px 1fr 44px; gap: 12px; align-items: center; background: none; border: 0; padding: 6px 8px; margin: 0 -8px; border-radius: 6px; cursor: pointer; text-align: left; }
    .bar-row:hover { background: var(--surface-2); }
    .bar-label { font-size: 13.5px; color: var(--text-2); }
    .bar { display: flex; height: 10px; border-radius: 999px; overflow: hidden; background: var(--surface-3); }
    .bar span { display: block; height: 100%; }
    .bar .crit { background: var(--crit); } .bar .high { background: var(--high); } .bar .med { background: var(--med); } .bar .low { background: var(--low); }
    .bar-n { text-align: right; font-weight: 600; font-size: 13.5px; }
    .legend { display: flex; flex-wrap: wrap; gap: 6px 14px; color: var(--text-3); font-size: 12.5px; }
    .legend span { display: inline-flex; align-items: center; gap: 6px; }

    /* Cluster reconnaissance (collapsed by default). */
    details.recon-card > summary { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    details.recon-card > summary h2 { font-size: 16px; }
    .recon-chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .recon-chip { font-size: 12.5px; color: var(--text-2); background: var(--surface-2); border: 1px solid var(--line); border-radius: 999px; padding: 1px 10px; }
    .recon-chip strong { color: var(--text); }
    .recon-chip-danger { border-color: rgba(255,93,108,0.4); }
    .recon-chip-warn { border-color: rgba(255,157,74,0.4); }
    .recon-body { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 32px; margin-top: 18px; }
    .recon-section h3 { font-size: 13px; color: var(--text-3); font-weight: 600; margin-bottom: 6px; }
    .recon-row { display: grid; grid-template-columns: 150px 1fr; gap: 12px; padding: 5px 0; border-top: 1px solid var(--line-soft); font-size: 13.5px; }
    .recon-key { color: var(--text-3); }
    .recon-val { color: var(--text-2); min-width: 0; }
    .recon-val code { margin: 0 4px 2px 0; display: inline-block; }
    .recon-tag { display: inline-block; font-size: 11.5px; font-weight: 600; padding: 0 8px; border-radius: 999px; margin: 0 4px 2px 0; background: var(--info-soft); color: var(--info); }
    a.recon-tag:hover { text-decoration: none; filter: brightness(1.15); }
    .tag-danger { background: var(--crit-soft); color: var(--crit); }
    .tag-warn { background: var(--high-soft); color: var(--high); }
    .tag-ok { background: var(--low-soft); color: var(--low); }
    .recon-empty, .recon-more { color: var(--text-3); }
    .recon-prov { grid-column: 1 / -1; }

    /* --- Attack paths ------------------------------------------------------ */
    .target-picker { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
    .target-btn { display: inline-flex; align-items: center; gap: 8px; background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; cursor: pointer; color: var(--text-2); font-weight: 600; font-size: 13.5px; }
    .target-btn:hover { border-color: var(--line-strong); color: var(--text); }
    .target-btn[aria-selected="true"] { border-color: var(--accent); background: var(--accent-soft); color: var(--text); }
    .target-btn .n { color: var(--text-3); font-weight: 600; }
    html:not(.js) .target-picker { display: none; }
    .js .target-view { display: none; }
    .js .target-view.is-active { display: block; }
    html:not(.js) .target-view + .target-view { margin-top: 40px; }
    .tv-hd { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 4px; }
    .tv-blurb { color: var(--text-2); margin-bottom: 14px; }
    .graph-card { padding: 0; overflow: hidden; }
    .graph-bar { display: flex; align-items: center; gap: 10px 18px; flex-wrap: wrap; padding: 11px 18px; border-bottom: 1px solid var(--line-soft); font-size: 13px; color: var(--text-3); }
    .graph-bar .legend { margin-left: auto; display: inline-flex; flex-wrap: wrap; gap: 6px 16px; }
    .graph-bar .legend > span { display: inline-flex; align-items: center; gap: 7px; white-space: nowrap; }
    .graph-hint { color: var(--text-3); }
    .focus-note { display: none; align-items: center; gap: 8px; color: var(--text); }
    .focus-note button { background: var(--surface-3); border: 1px solid var(--line-strong); border-radius: 6px; padding: 1px 10px; font-size: 12.5px; font-weight: 600; cursor: pointer; color: var(--text-2); }
    .focus-note button:hover { color: var(--text); }
    .target-view.has-focus .focus-note { display: inline-flex; }
    .target-view.has-focus .graph-hint { display: none; }
    .graph-scroll { overflow-x: auto; background: #0c111c; }
    /* The diagram scales down to the card width (its viewBox keeps the proportions) and scrolls sideways only below a readable size. */
    .graph-scroll svg { display: block; margin: 0 auto; width: 100%; min-width: 720px; height: auto; }
    .lg-line { display: inline-block; width: 24px; height: 0; border-top: 2px solid #7f90b3; }
    .lg-line.moderate { border-top-style: dashed; }
    .lg-line.hard { border-top-style: dotted; }
    .lg-box { display: inline-block; width: 16px; height: 11px; border-radius: 4px; border: 1.5px solid #4a5a7c; background: #19223a; }
    .lg-box.group { box-shadow: 3px -3px 0 -1px #19223a, 3px -3px 0 0 #4a5a7c; }
    .lg-box.sink { border-style: dashed; }

    /* --- Attack-path diagram ---------------------------------------------- */
    /* Canvas: a dotted grid with one faint lane per column. */
    .ap-bg { fill: url(#ap-dots); }
    .ap-lane { fill: rgba(255,255,255,0.022); }
    .ap-lane.target { fill: rgba(255,255,255,0.04); }
    .ap-col { fill: var(--text-3); font-size: 10.5px; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; }
    /* Edges: a base stroke, an arrowhead, a flowing overlay shown only while lit, and a wide invisible hit area. */
    .ap-edge { fill: none; stroke: #5b6c92; stroke-opacity: 0.8; stroke-linecap: round; transition: stroke 0.15s ease, opacity 0.15s ease; }
    .ap-edge.moderate { stroke-dasharray: 7 5; }
    .ap-edge.hard { stroke-dasharray: 2 5; }
    .ap-arrow { fill: #6f80a8; transition: fill 0.15s ease, opacity 0.15s ease; }
    .ap-flow { fill: none; stroke: #dcefff; stroke-width: 2.4; stroke-linecap: round; stroke-dasharray: 3 15; display: none; animation: ap-flow 1.1s linear infinite; }
    .ap-hit { fill: none; stroke: transparent; stroke-width: 16; pointer-events: stroke; cursor: pointer; }
    @keyframes ap-flow { to { stroke-dashoffset: -18; } }
    /* Nodes: a card with a sheen, an icon tile tinted by the worst severity through it, two text lines. */
    .ap-node { cursor: pointer; }
    /* The browser draws its own ring around a focused SVG group; the box border carries focus instead. */
    .ap-node:focus, .ap-node:focus-visible { outline: none; }
    .ap-in { filter: drop-shadow(0 3px 8px rgba(0,0,0,0.45)); }
    .ap-box { fill: #19223a; stroke: #334159; stroke-width: 1; transition: stroke 0.15s ease; }
    .ap-sheen { fill: url(#ap-sheen); pointer-events: none; }
    .ap-node.via .ap-box { fill: #1c2640; }
    .ap-node.sink .ap-box { fill: #171f33; stroke-dasharray: 4 3; }
    .ap-stack { fill: #141c30; stroke: #3d4c6c; stroke-width: 1; }
    .ap-node:hover .ap-box, .ap-node:focus-visible .ap-box, .ap-node.pinned .ap-box { stroke: var(--accent); }
    .ap-node.pinned .ap-box { stroke-width: 1.8; }
    .ap-tile { fill: var(--info-soft); }
    .ap-icon { color: var(--info); }
    .ap-node.crit .ap-tile { fill: var(--crit-soft); } .ap-node.crit .ap-icon { color: var(--crit); }
    .ap-node.high .ap-tile { fill: var(--high-soft); } .ap-node.high .ap-icon { color: var(--high); }
    .ap-node.med .ap-tile { fill: var(--med-soft); } .ap-node.med .ap-icon { color: var(--med); }
    .ap-node.low .ap-tile { fill: var(--low-soft); } .ap-node.low .ap-icon { color: var(--low); }
    .ap-title { fill: var(--text); font-size: 13px; font-weight: 600; }
    .ap-sub { fill: var(--text-3); font-size: 11px; }
    /* The target: tinted card, severity-coloured border, a slow-breathing glow behind it. */
    .ap-node.target .ap-box { stroke-width: 1.4; }
    .ap-node.target .ap-title { font-size: 14px; }
    .ap-node.target .ap-sub { fill: var(--text-2); }
    .ap-node.target .ap-tile { fill: rgba(255,255,255,0.09); }
    .ap-node.target.crit .ap-box { fill: #2a1621; stroke: var(--crit); }
    .ap-node.target.high .ap-box { fill: #2a1d13; stroke: var(--high); }
    .ap-node.target.med .ap-box, .ap-node.target.low .ap-box, .ap-node.target.info .ap-box { fill: #292417; stroke: var(--med); }
    .ap-node.target.low .ap-box { fill: #16291f; stroke: var(--low); }
    .ap-glow { fill: var(--med); opacity: 0.4; filter: url(#ap-blur); animation: ap-pulse 3.4s ease-in-out infinite; }
    .ap-node.crit .ap-glow { fill: var(--crit); } .ap-node.high .ap-glow { fill: var(--high); } .ap-node.low .ap-glow { fill: var(--low); }
    @keyframes ap-pulse { 0%, 100% { opacity: 0.3; } 50% { opacity: 0.6; } }
    /* Highlight state: dim everything, then light the paths through the hovered or focused element. */
    /* opacity, not stroke-opacity: it also fades the arrowheads. */
    svg.is-dim .ap-edge, svg.is-dim .ap-arrow { opacity: 0.1; }
    svg.is-dim .ap-edge.lit { opacity: 1; stroke: var(--accent); stroke-opacity: 1; filter: drop-shadow(0 0 5px rgba(116,184,255,0.55)); }
    svg.is-dim .ap-arrow.lit { opacity: 1; fill: var(--accent); }
    svg.is-dim .ap-flow.lit { display: block; }
    svg.is-dim .ap-node { opacity: 0.22; }
    svg.is-dim .ap-node.lit { opacity: 1; }
    .ap-elabel { display: none; pointer-events: none; }
    svg.is-dim .ap-elabel.lit { display: block; }
    .ap-elabel rect { fill: #0b1020; fill-opacity: 0.96; stroke: rgba(116,184,255,0.5); }
    .ap-elabel text { fill: var(--text); font-size: 10.5px; font-weight: 600; }
    /* Entrance: boxes slide in column by column each time a target is opened, edges fade in after them. */
    .js .target-view.is-active .ap-in { animation: ap-in 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
    /* The delays carry the same prefix as the shorthand above, which would otherwise reset them to 0s. */
    .js .target-view.is-active .ap-node.c1 .ap-in { animation-delay: 90ms; }
    .js .target-view.is-active .ap-node.c2 .ap-in { animation-delay: 180ms; }
    .js .target-view.is-active .ap-node.c3 .ap-in { animation-delay: 270ms; }
    .js .target-view.is-active .ap-node.c4 .ap-in { animation-delay: 360ms; }
    .js .target-view.is-active .ap-node.c5 .ap-in { animation-delay: 450ms; }
    .js .target-view.is-active .ap-node.c6 .ap-in { animation-delay: 540ms; }
    .js .target-view.is-active .ap-edges, .js .target-view.is-active .ap-labels { animation: ap-fade 0.6s 0.35s both; }
    @keyframes ap-in { from { opacity: 0; transform: translateX(-14px); } }
    @keyframes ap-fade { from { opacity: 0; } }
    @media (prefers-reduced-motion: reduce) {
      .ap-in, .ap-edges, .ap-labels, .ap-glow, .ap-flow { animation: none !important; }
    }
    /* Floating card for the box under the pointer: the full identity, where it lives, how many paths run through it. */
    .ap-tip { position: absolute; z-index: 40; max-width: 380px; background: #070a11; border: 1px solid var(--line-strong); border-radius: 10px; padding: 10px 13px; font-size: 12.5px; color: var(--text-2); pointer-events: none; transform: translate(-50%, calc(-100% - 12px)); box-shadow: 0 12px 32px rgba(0,0,0,0.5); line-height: 1.45; }
    .ap-tip.below { transform: translate(-50%, 12px); }
    .ap-tip strong { display: block; color: var(--text); font-family: var(--mono); font-size: 12.5px; overflow-wrap: anywhere; margin-bottom: 3px; }
    .ap-tip .k { display: block; }
    .ap-tip .n { display: block; margin-top: 5px; color: var(--text-3); }
    .ap-tip .n b { font-weight: 700; }
    .ap-tip .n b.crit { color: var(--crit); } .ap-tip .n b.high { color: var(--high); } .ap-tip .n b.med { color: var(--med); } .ap-tip .n b.low { color: var(--low); }
    .ap-tip .m { display: block; margin-top: 5px; font-family: var(--mono); font-size: 11.5px; color: var(--text-3); overflow-wrap: anywhere; }

    .path-list { margin-top: 18px; }
